# Copy to .env for local development. Never commit real credentials.
# Shell environment overrides .env; .env overrides config/example/*.yml.

# Required by the API and worker. Generate with: openssl rand -base64 32
SECURITY_MASTERKEY=
SECURITY_IPHASHSALT=

# Local Compose database password. Set the same value in Portainer for production.
DATABASE_MAIN_PASSWORD=postgres

# DOKU sandbox is disabled until both credentials are set.
# PAYMENT_DOKU_BASEURL=https://api-sandbox.doku.com
# PAYMENT_DOKU_CLIENTID=
# PAYMENT_DOKU_SECRETKEY=
# PAYMENT_PUBLICBASEURL=http://localhost:3001
# PAYMENT_DOKU_NOTIFYPATH=/api/v1/payments/doku/notifications

# Optional email settings; development defaults to log-only.
# MAIL_DRIVER=log
# MAIL_FROM="Lagu Untukmu <no-reply@example.com>"
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USERNAME=
# MAIL_SMTP_PASSWORD=
# Brevo transactional email (https://api.brevo.com/v3/smtp/email). The key comes from
# Brevo -> SMTP & API -> API Keys; the sender address must be verified in Brevo.
# MAIL_BREVO_APIKEY=
# MAIL_BREVO_BASEURL=https://api.brevo.com
# MAIL_BREVO_SENDERNAME=Lagu Untukmu
# MAIL_BREVO_SENDEREMAIL=
# MAIL_BREVO_TIMEOUT=30s
# MAIL_BREVO_MAXATTEMPTS=3
# MAIL_BREVO_SANDBOX=false

# "Your song is ready" email, sent by the worker right after a song is generated.
# NOTIFICATION_ENABLED=false
# NOTIFICATION_ATTACHFULLAUDIO=false
# NOTIFICATION_MAXATTACHMENTMB=3
# NOTIFICATION_SITEURL=https://laguuntukmu.id

# Switch to S3-compatible storage for production if desired.
# STORAGE_DRIVER=s3
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=ap-southeast-1
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_ACCESSKEYID=
# STORAGE_S3_SECRETACCESSKEY=
# STORAGE_S3_USEPATHSTYLE=false
# STORAGE_S3_PREFIX=

# Optional listener and logging overrides.
# SERVER_REST_PORT=8080
# SERVER_REST_ENV=development
# LOGGER_LEVEL=debug
# LOGGER_FORMAT=text
